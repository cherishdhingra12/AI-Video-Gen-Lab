    # A bare question still is not a moral — but only if the line itself is offered as the moral.
    # A line whose body is a statement that happens to end in "?" (e.g. "the question every child asks:") or
    # whose proper body follows an intro colon is the critic's call, not a hard block.
    head, _, tail = moral.partition(":")
